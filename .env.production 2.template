# Ocean City Hemp Kiosk - Production Environment Variables
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# SECURITY SETTINGS (REQUIRED)
# =============================================================================

# Generate a new secret key for production
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-cryptographically-strong-secret-key-here

# Comma-separated list of allowed hostnames/domains
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL database settings
DB_NAME=oceancityhemp
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# SSL/HTTPS SETTINGS
# =============================================================================

# Enable HTTPS redirects (set to False for testing)
SECURE_SSL_REDIRECT=True

# HSTS settings (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================

# SMTP settings for error notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@oceancityhemp.com
ADMIN_EMAIL=admin@oceancityhemp.com

# =============================================================================
# CACHE CONFIGURATION (OPTIONAL)
# =============================================================================

# Redis cache URL (install redis-server)
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# BACKUP AND MONITORING (RECOMMENDED)
# =============================================================================

# Sentry DSN for error monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here

# Backup settings
BACKUP_STORAGE_PATH=/path/to/backup/storage
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# =============================================================================
# EXAMPLE PRODUCTION VALUES (DO NOT USE AS-IS)
# =============================================================================

# SECRET_KEY=django-insecure-example-key-replace-this-in-production
